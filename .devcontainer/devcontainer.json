{
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "installOhMyZsh": true,
      "installOhMyZshConfig": true,
      "upgradePackages": true,
      "username": "vscode"
    },
    "ghcr.io/devcontainers/features/git:1": {
      "ppa": true,
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24",
      "nodeGypDependencies": true
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11",
      "installTools": true
    },
    "ghcr.io/devcontainers-extra/features/bun:1": {
      "version": "1.3.13"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "containerUser": "vscode",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "containerEnv": {
    "BUN_INSTALL": "/home/vscode/.bun",
    "ANTHROPIC_BASE_URL": "https://vllm.local",
    "ANTHROPIC_API_KEY": "sk-dummy-key",
    "CLAUDE_CODE_MODEL": "primary",
    "PI_VLLM_PROVIDER": "vllm.local",
    "PI_VLLM_MODEL": "primary",
    "PI_VLLM_BASE_URL": "https://vllm.local",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
    "NODE_OPTIONS": "--use-system-ca",
    "NODE_EXTRA_CA_CERTS": "/usr/local/share/ca-certificates/enclave-root-ca.crt",
    "PI_CODING_AGENT_DIR": "/home/vscode/.pi-devcontainer/agent"
  },
  "remoteEnv": {
    "PATH": "/home/vscode/.local/bin:/home/vscode/.bun/bin:${containerEnv:PATH}",
    "PI_WORKSPACE_FOLDER": "${containerWorkspaceFolder}",
    "PI_DEVCONTAINER_REPO": "perfagent-cli",
    "PI_PROJECT_SETUP": "pnpm"
  },
  "mounts": [
    "source=${localEnv:HOME}/code/pi-devcontainer-yolo,target=/home/vscode/code/pi-devcontainer-yolo,type=bind,consistency=cached",
    "source=${localEnv:HOME}/code/neuve-harness,target=/home/vscode/code/neuve-harness,type=bind,consistency=cached",
    "source=${localEnv:HOME}/code/neuve-git,target=/home/vscode/code/neuve-git,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached",
    "source=${localEnv:HOME}/Downloads,target=/mnt/host-downloads,type=bind,readonly"
  ],
  "runArgs": [
    "--add-host=vault.enclave.local:192.168.1.242",
    "--add-host=nextcloud.enclave.local:192.168.1.242",
    "--add-host=harbor.enclave.local:192.168.1.242",
    "--add-host=keycloak.enclave.local:192.168.1.242",
    "--add-host=grafana.enclave.local:192.168.1.242",
    "--add-host=openwebui.enclave.local:192.168.1.242",
    "--add-host=webservice.gitlab.local:192.168.1.242",
    "--add-host=vaultwarden.enclave.local:192.168.1.242",
    "--add-host=notes.enclave.local:192.168.1.242",
    "--add-host=prometheus.enclave.local:192.168.1.242",
    "--add-host=vllm.local:192.168.1.242"
  ],
  "postCreateCommand": "bash /home/vscode/code/pi-devcontainer-yolo/devcontainers/common-post-create.sh",
  "postStartCommand": "git config --global --add safe.directory ${containerWorkspaceFolder}",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": {
            "path": "/usr/bin/zsh"
          }
        },
        "typescript.tsdk": "node_modules/typescript/lib",
        "editor.formatOnSave": false,
        "git.autofetch": true,
        "editor.defaultFormatter": "oxc.oxc-vscode",
        "editor.codeActionsOnSave": {
          "source.format.oxc": "always",
          "source.fixAll.oxc": "always"
        }
      },
      "extensions": [
        "dbaeumer.vscode-eslint",
        "ms-azuretools.vscode-docker",
        "oxc.oxc-vscode",
        "ms-playwright.playwright"
      ]
    }
  },
  "name": "PerfAgent CLI",
  "forwardPorts": [
    3000,
    5173,
    9222
  ],
  "portsAttributes": {
    "3000": {
      "label": "Web"
    },
    "5173": {
      "label": "Vite"
    },
    "9222": {
      "label": "CDP"
    }
  },
  "onCreateCommand": "sudo apt-get update && sudo apt-get install -y build-essential ca-certificates curl fd-find jq less libssl-dev lsof nano netcat-openbsd pkg-config python3 python3-pip python3-venv ripgrep shellcheck unzip vim xz-utils zip && sudo ln -sf /usr/bin/fdfind /usr/local/bin/fd && sudo apt-get clean && sudo rm -rf /var/lib/apt/lists/*"
}
